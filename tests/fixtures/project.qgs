    <maplayer><datasource>folderdata</datasource></maplayer>
    <maplayer><datasource>data/missing.shp</datasource></maplayer>
    <maplayer><datasource>memory?geometry=Point</datasource></maplayer>
    <maplayer><datasource>https://example.com/service</datasource></maplayer>
