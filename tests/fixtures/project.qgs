<qgis version="3.40">
  <projectlayers>
    <maplayer><datasource>data/roads.shp|layername=roads</datasource></maplayer>
    <maplayer source="data/roads.shp|layername=labels" />
    <maplayer><datasource>one/data.gpkg|layername=one</datasource></maplayer>
    <maplayer><datasource>two/data.gpkg|layername=two</datasource></maplayer>
    <maplayer><datasource>file:data/space%20data.csv?type=csv&amp;delimiter=,</datasource></maplayer>
    <maplayer><datasource>data/photo.tif</datasource></maplayer>
    <maplayer><datasource>folderdata</datasource></maplayer>
    <maplayer><datasource>data/missing.shp</datasource></maplayer>
    <maplayer><datasource>memory?geometry=Point</datasource></maplayer>
    <maplayer><datasource>https://example.com/service</datasource></maplayer>
    <maplayer><datasource>crs=EPSG:3857&amp;type=xyz&amp;url=https://tiles.example.com/{z}/{x}/{y}.png</datasource></maplayer>
    <maplayer><datasource>dbname='./data/places.sqlite' table="places" (geom)</datasource></maplayer>
    <maplayer><datasource>dbname='gis' host=localhost port=5432 sslmode=disable key='id' table="public"."roads" (geom)</datasource></maplayer>
    <maplayer><datasource>/vsizip/./data/zipped.zip/inner/points.csv</datasource></maplayer>
    <maplayer><datasource>/vsizip/{./data/zipped.zip}/inner/points.csv|layername=points</datasource></maplayer>
    <maplayer><datasource>/vsicurl/https://example.com/remote.tif</datasource></maplayer>
    <symbol source="base64:PD94bWw+" />
    <expression id="multiline" value="CASE&#xA;&#x9;WHEN 1 THEN 'a'&#xD;&#xA;END" />
    <delimiter> </delimiter>
  </projectlayers>
</qgis>
